# ── Conexión ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:1234@localhost:5432/luta_danca
PORT=5000
HOST=0.0.0.0
# Puerto interno de MATCTRL; se expone a los usuarios bajo PORT en /matctrl.
MATCTRL_PORT=3001

# ── Seguridad / sesiones ──────────────────────────────────
# Genera una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=genera_una_secreta_aqui
JWT_EXPIRES=30d

# ── Archivos subidos ───────────────────────────────────────
UPLOAD_FOLDER=./uploads
MAX_VIDEO_MB=500
MAX_IMAGE_MB=10

# ── Monetización (defaults; la comisión global y moneda se
#    gestionan además desde el panel de moderador) ─────────
COMISION_PLATAFORMA=0.30
MONEDA_DEFAULT=USD
MOD_VOTOS=2

# ── Clave privada para promocionar una cuenta a moderador ───
# Usa un valor aleatorio único de al menos 32 caracteres en tu .env local.
# Para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOD_SECRET_CODE=
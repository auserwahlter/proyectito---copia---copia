# PostgreSQL
DATABASE_URL=postgresql://matctrl:matctrl@localhost:5432/matctrl

# Servidor interno (el acceso público pasa por el puerto principal en /matctrl)
PORT=3001
AUTO_MIGRATE=true

# MediaMTX
MEDIAMTX_WHIP_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_PLAYBACK_URL=http://localhost:9996
# El frontend usa /whip; Vite en desarrollo y Express en producción lo redirigen a MediaMTX.
VITE_WHIP_BASE=/whip

# ICE (opcional, para clientes fuera de la red local)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Limite de subida de miniaturas
MAX_THUMBNAIL_BYTES=5242880

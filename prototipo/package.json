{
  "name": "prototipo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "oxlint",
    "db:up": "docker compose up -d db mediamtx",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db mediamtx",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "db:reset": "docker compose down -v && docker compose up -d db mediamtx && node server/migrate.js && node server/seed.js",
    "db:dump": "docker compose exec -T db pg_dump -U matctrl matctrl > backups/matctrl.sql"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.61.0",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
